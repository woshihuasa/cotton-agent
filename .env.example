# ── DeepSeek 官方（LLM_PROVIDER 留空时使用；最少配置即可跑通的路径）──
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ── 默认模型服务商（登记名见 core/providers.py：deepseek / qwen）──
# 留空 = 用上面的 DEEPSEEK_*；设为 qwen 后端点与密钥取自登记表，
# **不再读 DEEPSEEK_BASE_URL / DEEPSEEK_MODEL**。
LLM_PROVIDER=
# 留空 = 用该服务商的 default_model
LLM_MODEL=

# ── 千问 Token Plan（LLM_PROVIDER=qwen 时必填）──
DASHSCOPE_API_KEY=sk-sp-your-dashscope-key

# 高德地图 API（天气查询）
AMAP_API_KEY=your-amap-api-key

# Tavily API（联网搜索）
TAVILY_API_KEY=tvly-your-tavily-api-key

# === Embedding（旧三件套 = 向后兼容路径）===
# ★ EMBEDDING_PROVIDER 留空时，端点/模型/密钥**完全取自这三个键**，
#   行为与改造前逐字一致（知识库指纹也不变，不会被无谓重建）。
#   也可以在「设置 → Embedding」里添加任意 OpenAI 兼容服务商并设为默认，
#   那时端点与模型取自登记表，密钥存在凭据层（键名 `embed:<名称>`）。
EMBEDDING_API_KEY=sk-your-embedding-api-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 默认 Embedding 服务商（登记名见 core/embedding_providers.py：siliconflow / openai）
# 留空 = 沿用上面三个旧键
EMBEDDING_PROVIDER=

# === 精排（rerank）===
# 启用后：向量召回 RERANK_RECALL_K 条 → 精排 → 取 top-k
RERANK_ENABLED=1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# ★ 精排与 Embedding 解耦：下面两项**留空 = 继承当前 Embedding 服务商**（推荐）。
#   换了 Embedding 供应商、却还想用原来那家的 /rerank 时，在这里显式指回去。
#   （`POST {RERANK_BASE_URL}/rerank` 是硅基流动专有的接口形状，不是 OpenAI 兼容标准）
RERANK_BASE_URL=
RERANK_API_KEY=

# === GitHub 更新检查（可选，配置后启用自动更新）===
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name

# === 埋点（可选，默认关闭）===
# 打开后每次问答 / 每条推送的每一步耗时都会记到 %APPDATA%\CottonAgent\traces\。
# 用 python tools/traces.py list 查看，show <id> 看单条时间线。
# 只记模型名、token 数、耗时、工具名与成败；正文要显式打开下面的开关才记。
OBSERVABILITY_ENABLED=0
OBSERVABILITY_CAPTURE_TEXT=0
# 自定义记录目录（留空用 app_data 下的 traces/）
OBSERVABILITY_DIR=
